<template>
  <div class="root" style="padding: {{pad}}px" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="head">
      <text class="title" style="font-size: {{titleFs}}px">记录</text>
      <text class="count" style="font-size: {{noFs}}px">{{count}}</text>
    </div>
    <scroll class="list" scroll-y="true">
      <div class="item" for="{{records}}" tid="id" style="height: {{itemH}}px; border-radius: {{itemR}}px" onclick="onPick($idx)" onlongpress="onDrop($idx)">
        <div class="{{$item.side}}" style="height: {{barH}}px; width: {{accentW}}px; margin-left: {{accentMl}}px"></div>
        <text class="no" style="font-size: {{noFs}}px; width: {{noW}}px; margin-left: {{noMl}}px">{{$item.no}}</text>
        <text class="val" style="font-size: {{valFs}}px; width: {{valW}}px">{{$item.score}}</text>
        <text class="time" style="font-size: {{noFs}}px; width: {{timeW}}px; margin-right: {{timeMr}}px">{{$item.time}}</text>
      </div>
      <div class="empty" if="{{empty}}">
        <text class="emptyText">还没有记录</text>
      </div>
    </scroll>
    <div class="foot">
      <text class="footText" style="font-size: {{noFs}}px">单击恢复 · 长按删除</text>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import router from '@system.router'
import device from '@system.device'
import { loadRecords, saveRecords, saveScore, requestScoreRefresh, formatTime, MAX_RECORDS } from '../../common/store.js'

function coord(evt) {
  let t = evt
  if (evt && evt.touches && evt.touches.length) t = evt.touches[0]
  else if (evt && evt.changedTouches && evt.changedTouches.length) t = evt.changedTouches[0]
  if (!t) return null
  let x = t.clientX
  if (x === undefined || x === null) x = t.pageX
  if (x === undefined || x === null) x = t.offsetX
  let y = t.clientY
  if (y === undefined || y === null) y = t.pageY
  if (y === undefined || y === null) y = t.offsetY
  if (x === undefined || x === null || y === undefined || y === null) return null
  return { x: x, y: y }
}

const DESIGN_W = 480

function metricsOf(w, h, shape) {
  const dw = DESIGN_W
  const dh = dw * h / w
  let pad = 10
  if (shape === 'circle') pad = Math.round(dw * 0.1465)
  else if (shape === 'pill-shaped') pad = 14
  const itemH = Math.max(56, Math.min(120, Math.round(dh * 0.078)))
  const accentW = Math.max(6, Math.round(itemH * 0.09))
  const accentMl = Math.round(itemH * 0.19)
  const noW = Math.round(itemH * 0.34)
  const noMl = Math.round(itemH * 0.10)
  const timeW = Math.round(itemH * 0.78)
  const timeMr = Math.round(itemH * 0.12)
  const valW = dw - pad * 2 - (accentW + accentMl) - (noW + noMl) - (timeW + timeMr)
  return {
    pad: pad,
    itemH: itemH,
    itemR: Math.round(itemH * 0.27),
    barH: Math.round(itemH * 0.58),
    valFs: Math.round(itemH * 0.48),
    noFs: Math.max(16, Math.round(itemH * 0.25)),
    titleFs: Math.max(20, Math.round(dh * 0.031)),
    accentW: accentW,
    accentMl: accentMl,
    noW: noW,
    noMl: noMl,
    valW: valW < 60 ? 60 : valW,
    timeW: timeW,
    timeMr: timeMr
  }
}

export default {
  private: {
    records: [],
    count: '',
    empty: true,
    pad: 10,
    itemH: 96,
    itemR: 26,
    barH: 56,
    valFs: 46,
    noFs: 24,
    titleFs: 38,
    accentW: 9,
    accentMl: 18,
    noW: 33,
    noMl: 10,
    valW: 240,
    timeW: 75,
    timeMr: 12
  },

  onInit() {
    this.startPoint = null
    this.raw = []
  },

  onReady() {
    this.syncDevice()
    this.render()
  },

  onShow() {
    this.render()
  },

  syncDevice() {
    const that = this
    try {
      device.getInfo({
        success: function (ret) {
          if (!ret || !ret.screenWidth || !ret.screenHeight) return
          that.applyMetrics(ret.screenWidth, ret.screenHeight, ret.screenShape)
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  applyMetrics(w, h, shape) {
    const m = metricsOf(w, h, shape)
    this.pad = m.pad
    this.itemH = m.itemH
    this.itemR = m.itemR
    this.barH = m.barH
    this.valFs = m.valFs
    this.noFs = m.noFs
    this.titleFs = m.titleFs
    this.accentW = m.accentW
    this.accentMl = m.accentMl
    this.noW = m.noW
    this.noMl = m.noMl
    this.valW = m.valW
    this.timeW = m.timeW
    this.timeMr = m.timeMr
  },

  onDestroy() {
    this.raw = []
  },

  render() {
    const that = this
    loadRecords(function (list) {
      that.raw = list || []
      const rows = []
      for (let i = 0; i < that.raw.length; i++) {
        const it = that.raw[i]
        rows.push({
          id: 'r' + i,
          no: String(i + 1),
          score: it.t + ':' + it.b,
          time: formatTime(it.ts),
          side: i % 2 === 0 ? 'accent accentA' : 'accent accentB'
        })
      }
      that.records = rows
      that.empty = rows.length === 0
      that.count = rows.length + ' / ' + MAX_RECORDS
    })
  },

  buzz(mode) {
    try {
      vibrator.vibrate({ mode: mode || 'short' })
    } catch (e) {}
  },

  // 单击：把这条比分恢复到记分页
  onPick(idx) {
    const it = this.raw[idx]
    if (!it) return
    const that = this
    saveScore(it.t, it.b)
    requestScoreRefresh()
    this.buzz('short')
    setTimeout(function () {
      try {
        router.back()
      } catch (e) {}
    }, 80)
  },

  // 长按：删除这条
  onDrop(idx) {
    const it = this.raw[idx]
    if (!it) return
    const list = this.raw.slice(0)
    list.splice(idx, 1)
    this.raw = list
    this.buzz('short')
    saveRecords(list)
    this.render()
  },

  // ---------- 手势：左 -> 右 返回记分页 ----------
  onTouchStart(evt) {
    this.startPoint = coord(evt)
  },

  onTouchEnd(evt) {
    const start = this.startPoint
    this.startPoint = null
    const end = coord(evt)
    if (!start || !end) return
    const dx = end.x - start.x
    const dy = end.y - start.y
    if (Math.abs(dx) <= Math.abs(dy)) return
    if (dx > 90) {
      try {
        router.back()
      } catch (e) {}
    }
  }
}
</script>

<style>
.root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 10px;
  background-color: #070e12;
}

.head {
  height: 9%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 22px;
  padding-right: 22px;
}

.title {
  color: #d6e8eb;
}

.count {
  color: #6e8c9b;
}

.list {
  height: 84%;
}

.item {
  margin-bottom: 12px;
  flex-direction: row;
  align-items: center;
  border-width: 2px;
  border-color: #1b2932;
  border-radius: 26px;
  background-color: #101c23;
}

.accent {
  border-width: 2px;
  border-radius: 8px;
}

.accentA {
  background-color: #56d9ae;
  border-color: #56d9ae;
}

.accentB {
  background-color: #6cc5f3;
  border-color: #6cc5f3;
}

.no {
  color: #60808f;
}

.val {
  font-weight: bold;
  text-align: center;
  color: #deeef5;
}

.time {
  text-align: right;
  color: #60808f;
}

.empty {
  height: 120px;
  align-items: center;
  justify-content: center;
}

.emptyText {
  font-size: 26px;
  color: #4f6b78;
}

.foot {
  height: 7%;
  align-items: center;
  justify-content: center;
}

.footText {
  color: #4f6b78;
}
</style>
