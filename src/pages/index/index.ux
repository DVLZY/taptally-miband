<template>
  <div class="root" style="padding: {{pad}}px" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="card cardTop {{rCls}}" style="height: {{cardH}}px" onclick="onTop" onlongpress="onTopLong">
      <text class="score scoreTop" style="font-size: {{fsTop}}px">{{top}}</text>
    </div>
    <div class="mid" style="height: {{gapH}}px" onlongpress="onMidLong">
      <!-- 中缝时间：小时靠左、分钟靠右，无冒号；小时十位与分钟个位用大字号。
           四个数字各自在自己的行盒里垂直居中，所以不会出现"踩在同一条基线"上 -->
      <div class="clock" if="{{clockOn}}">
        <div class="clockSide" style="margin-left: {{clockMargin}}px">
          <text class="clockBig" style="font-size: {{clockBig}}px">{{h1}}</text>
          <text class="clockSmall" style="font-size: {{clockSmall}}px">{{h2}}</text>
        </div>
        <div class="clockSide" style="margin-right: {{clockMargin}}px">
          <text class="clockSmall" style="font-size: {{clockSmall}}px">{{m1}}</text>
          <text class="clockBig" style="font-size: {{clockBig}}px">{{m2}}</text>
        </div>
      </div>
      <text class="midText" if="{{mid}}" style="font-size: {{midFs}}px">{{mid}}</text>
    </div>
    <div class="card cardBot {{rCls}}" style="height: {{cardH2}}px" onclick="onBottom" onlongpress="onBottomLong">
      <text class="score scoreBot" style="font-size: {{fsBot}}px">{{bottom}}</text>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import router from '@system.router'
import device from '@system.device'
import { loadScore, saveScore, addRecord, loadRecords, APP_VERSION } from '../../common/store.js'

const DESIGN_W = 480
let bootScore = null

function coord(evt) {
  let t = evt
  if (evt && evt.touches && evt.touches.length) t = evt.touches[0]
  else if (evt && evt.changedTouches && evt.changedTouches.length) t = evt.changedTouches[0]
  if (!t) return null
  let x = t.clientX
  if (x === undefined || x === null) x = t.pageX
  if (x === undefined || x === null) x = t.offsetX
  let y = t.clientY
  if (y === undefined || y === null) y = t.pageY
  if (y === undefined || y === null) y = t.offsetY
  if (x === undefined || x === null || y === undefined || y === null) return null
  return { x: x, y: y }
}

// 由屏幕宽高推出「设计高度」，再据此算卡片与字号：
// 任何比例的屏幕（手环 192x490、9 Pro 336x480、圆表 466x466…）都能自适应
function metricsOf(w, h, shape) {
  const dw = DESIGN_W
  const dh = dw * h / w
  // 圆屏必须留边（方角位置是屏幕外），胶囊屏（手环9/10）贴边显示，
  // 否则上下会露出一圈黑边
  // 卡片贴边（pad=0）：让卡片弧线与屏幕边缘弧线同心，
  // 手环9 的屏幕是胶囊形（屏宽 192 → 圆角半径 96 物理 = 240 设计像素），
  // 所以四角直接用 240px，两端弧线就跟屏幕边缘完全重合。
  const pad = 0
  // 中缝高度：1.8.0 起从 4% 加宽到 13%，腾出空间放时间（见 docs/CHANGELOG）
  const gap = Math.round(dh * 0.13)
  // 用整数像素分配高度，剩下的零头给下半区，保证两块+窄缝正好等于可用高度
  const usable = dh - pad * 2
  const cardH = Math.floor((usable - gap) / 2)
  const cardH2 = usable - gap - cardH
  const cardW = dw - pad * 2
  // 时钟字号按中缝高度推：手环9 上 gap=159 → 大 189 / 小 122，墨迹正好填满且上下留 6 设计像素
  const clockBig = Math.max(24, Math.round(gap * 1.19))
  const clockSmall = Math.max(16, Math.round(gap * 0.766))
  const clockMargin = Math.max(6, Math.round(gap * 0.10))
  return { dh: dh, pad: pad, gap: gap, cardH: cardH, cardH2: cardH2, cardW: cardW,
           clockBig: clockBig, clockSmall: clockSmall, clockMargin: clockMargin }
}

export default {
  private: {
    top: '0',
    bottom: '0',
    rCls: '',
    fsTop: 425,
    fsBot: 425,
    pad: 0,
    gapH: 48,
    cardH: 574,
    cardH2: 574,
    midFs: 24,
    mid: '',
    armed: false,
    // 中缝时间：h1/h2 = 小时两位，m1/m2 = 分钟两位；clockOn=false 时整行不渲染
    h1: '', h2: '', m1: '', m2: '',
    clockOn: false,
    clockBig: 189,
    clockSmall: 122,
    clockMargin: 16
  },

  onInit() {
    this.armTimer = 0 // 上滑「再滑确认」的计时器
    this.midTimer = 0 // 中间提示文字的计时器（两者必须分开，见 showMid 注释）
    this.startPoint = null
    this.restored = false
    this.touched = false
    // 手环 9（192x490 胶囊屏）的默认值，拿到真实设备信息后再覆盖。
    // 这里必须把 metrics 同步到视图字段：否则首帧用的是 CSS 里的百分比兜底，
    // 等 device.getInfo 回来才跳一次（表现为「闪一下」）。
    this.metrics = metricsOf(192, 490, 'pill-shaped')
    this.pad = this.metrics.pad
    this.gapH = this.metrics.gap
    this.cardH = this.metrics.cardH
    this.cardH2 = this.metrics.cardH2
    this.rCls = 'rndPill'
    this.midBigFs = Math.max(24, Math.round(this.metrics.gap * 0.30))
    this.midSmallFs = Math.max(20, Math.round(this.metrics.gap * 0.21))
    this.clockBig = this.metrics.clockBig
    this.clockSmall = this.metrics.clockSmall
    this.clockMargin = this.metrics.clockMargin
    this.clockTimer = 0
    this.clockOk = true      // Date 不可用时置 false，整行时间就不显示
    this.lastG = ''          // 最近一次触摸的 s.y/e.y/dy，供长按中缝查看
    this.dbgFlip = false
    this.midFs = this.midBigFs
    if (bootScore) {
      this.restored = true
      this.applyScore(bootScore.t, bootScore.b, false)
    }
  },

  onReady() {
    this.syncDevice()
    this.restore(false)
    this.startClock()
    // 预热历史记录缓存：加记录时才能合并出完整历史，而不是覆盖成 1 条
    loadRecords(function () {})
  },

  // 从列表页返回时**一定**强制回读一次磁盘：列表页可能刚把另一局的比分写进去
  onShow() {
    const that = this
    this.startClock()
    if (this.wasHidden) {
      this.wasHidden = false
      this.touched = false
      setTimeout(function () {
        that.restore(true)
      }, 60)
      return
    }
    if (!this.restored) this.restore(false)
  },

  onHide() {
    this.wasHidden = true
    this.saveNow()
    this.stopClock()
  },

  onDestroy() {
    this.saveNow()
    if (this.armTimer) clearTimeout(this.armTimer)
    if (this.midTimer) clearTimeout(this.midTimer)
    this.stopClock()
  },

  // 中缝时间：HH ｜ MM，小时十位与分钟个位用大字号。
  // 刷新对齐到「下一个整分钟」，而不是每 60 秒轮询——否则挂钟会越走越偏。
  startClock() {
    this.stopClock()
    this.tickClock()
  },

  stopClock() {
    if (this.clockTimer) {
      clearTimeout(this.clockTimer)
      this.clockTimer = 0
    }
  },

  tickClock() {
    const that = this
    let hh = '--'
    let mm = '--'
    let delay = 60000
    try {
      const d = new Date()
      const h = d.getHours()
      const m = d.getMinutes()
      hh = (h < 10 ? '0' : '') + h
      mm = (m < 10 ? '0' : '') + m
      // 下一次刷新的时刻：整分钟 + 一点点余量，避免还没跳到下一分钟就又刷了一次
      delay = 60000 - (d.getSeconds() * 1000 + d.getMilliseconds()) + 200
      if (delay < 1000) delay = 1000
    } catch (e) {
      // 某些机型/固件不给 Date：这时不显示时间，绝不显示空行
      that.clockOk = false
      that.clockOn = false
      return
    }
    this.h1 = hh.charAt(0)
    this.h2 = hh.charAt(1)
    this.m1 = mm.charAt(0)
    this.m2 = mm.charAt(1)
    this.clockOn = this.clockOk && this.mid === ''
    this.clockTimer = setTimeout(function () {
      that.tickClock()
    }, delay)
  },

  // 中间横条长按：显示「屏幕参数 + 版本号 + 已存记录条数」
  // 换机型、确认装上的是哪一版、排查记录条数，都靠这一行
  onMidLong() {
    const that = this
    this.buzz('short')
    // 两页诊断：第一页设备信息，再长按一次切到「最近一次手势读数」。
    // 手势改成全行程后要靠 s/e/dy 三个数确认阈值在这台机上合不合适。
    this.dbgFlip = !this.dbgFlip
    if (this.dbgFlip) {
      this.showMid('g ' + (this.lastG || '-') + ' dh' + Math.round(this.metrics ? this.metrics.dh : 0), 4000, true)
      return
    }
    loadRecords(function (list) {
      const shape = (that.devShape || '?').replace('pill-shaped', 'pill').replace('circle', 'circ')
      that.showMid(
        (that.devW || '?') + 'x' + (that.devH || '?') + ' ' + shape +
        ' v' + APP_VERSION + ' r' + (list ? list.length : 0),
        4000,
        true
      )
    }, true)
  },

  // 中间窄缝显示一行字（诊断串 / 「再滑确认」/「已存 N 条」）
  // 注意：这里只能清自己的 midTimer。1.7.0 及以前用的是 armTimer，
  // 结果长按中缝看诊断时会把「再滑确认」的计时器清掉、armed 却还是 true，
  // 下一次上滑就被当成第二次确认直接归零。
  showMid(text, ms, small) {
    const that = this
    this.midFs = small ? this.midSmallFs : this.midBigFs
    this.mid = text
    this.clockOn = this.clockOk && text === ''   // 有提示文字时先让出位置
    if (this.midTimer) clearTimeout(this.midTimer)
    this.midTimer = setTimeout(function () {
      that.mid = ''
      that.midTimer = 0
      that.clockOn = that.clockOk             // 提示消失，时间回来
    }, ms || 3000)
  },

  // ---------- 屏幕自适应 ----------
  syncDevice() {
    const that = this
    try {
      device.getInfo({
        success: function (ret) {
          if (!ret || !ret.screenWidth || !ret.screenHeight) return
          that.applyMetrics(ret.screenWidth, ret.screenHeight, ret.screenShape)
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  applyMetrics(w, h, shape) {
    // 圆角跟屏幕自身的圆角对齐：pill-shaped 屏（手环9）四角很圆，
    this.rCls = shape === 'pill-shaped' ? 'rndPill' : (shape === 'circle' ? 'rndCircle' : 'rndRect')
    this.devW = w
    this.devH = h
    this.devShape = shape || 'rect'
    this.metrics = metricsOf(w, h, shape)
    this.pad = this.metrics.pad
    this.gapH = this.metrics.gap
    this.cardH = this.metrics.cardH
    this.cardH2 = this.metrics.cardH2
    this.midBigFs = Math.max(24, Math.round(this.metrics.gap * 0.30))
    this.midSmallFs = Math.max(20, Math.round(this.metrics.gap * 0.21))
    this.clockBig = this.metrics.clockBig
    this.clockSmall = this.metrics.clockSmall
    this.clockMargin = this.metrics.clockMargin
    this.midFs = this.midBigFs
    this.syncFont()
  },

  // ---------- 读取 / 应用 ----------
  // force=true 用于「从列表页恢复比分」：磁盘写入是异步的，一次读不到就重试几次，
  // 否则会出现「跳回来了但比分没变」。
  restore(force) {
    const that = this
    // 非强制模式下，正在进行的首轮读取还没回来就别再发一次
    if (!force && this.restorePending) return
    this.restorePending = true
    // 兜底：万一某个通道的回调没回来，1.2 秒后也要把标记放开，
    // 否则后续 onShow 的恢复会被这个标记一直挡住
    setTimeout(function () {
      that.restorePending = false
    }, 1200)
    const attempt = function (left) {
      loadScore(function (sc) {
        that.restored = true
        if (sc) {
          that.restorePending = false
          that.applyScore(sc.t, sc.b, true)
          return
        }
        if (left > 1) {
          setTimeout(function () {
            attempt(left - 1)
          }, 150)
          return
        }
        that.restorePending = false
        that.syncFont()
      }, true)
    }
    attempt(force ? 4 : 1)
  },

  applyScore(t, b, defer) {
    const that = this
    const tt = t < 0 ? 0 : t
    const bb = b < 0 ? 0 : b
    bootScore = { t: tt, b: bb }
    const apply = function () {
      that.top = String(tt)
      that.bottom = String(bb)
      that.syncFont()
    }
    apply()
    if (defer) {
      setTimeout(function () {
        if (!that.touched) apply()
      }, 150)
    }
  },

  // ---------- 写入 ----------
  // 连点时会连续触发写盘，而手环的 flash 写入不宜过于频繁：
  // save() 只排一次 250ms 后的写；真正需要立即落盘的时机（退出、切页、归零、恢复）
  // 一律走 saveNow()。
  save() {
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    const that = this
    if (this.saveTimer) clearTimeout(this.saveTimer)
    this.saveTimer = setTimeout(function () {
      that.saveTimer = 0
      saveScore(bootScore.t, bootScore.b)
    }, 250)
  },

  saveNow() {
    if (this.saveTimer) {
      clearTimeout(this.saveTimer)
      this.saveTimer = 0
    }
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    saveScore(bootScore.t, bootScore.b)
  },

  // ---------- 基础 ----------
  buzz(mode) {
    try {
      vibrator.vibrate({ mode: mode || 'short' })
    } catch (e) {}
  },

  buzzDouble() {
    const that = this
    this.buzz('short')
    setTimeout(function () {
      that.buzz('short')
    }, 130)
  },

  num(v) {
    const n = parseInt(v, 10)
    return isNaN(n) ? 0 : n
  },

  // 字号同时受卡片宽、卡片高、圆角内缩三方面约束：位数越多越小，屏幕越矮越小。
  // 圆角 240px 时卡片两端是半圆，数字的上下两端会被弧线"吃掉"一部分宽度，
  // 所以按数字实际半高算出该高度处的可用宽度，迭代收敛（3 次足够）。
  sizeFor(n) {
    const d = String(n).length
    const m = this.metrics || metricsOf(192, 490, 'rect')
    const r = 240
    const byHeight = m.cardH * 0.74
    let f = Math.min(m.cardW / (0.60 * d) * 0.96, byHeight, 430)
    for (let i = 0; i < 3; i++) {
      const halfH = f * 0.36                       // 数字半高（字高约 0.72em）
      const straight = m.cardH / 2 - r             // 侧边还有多长是直的
      let inset = 0
      if (halfH > straight) {
        const k = halfH - Math.max(0, straight)
        const q = r * r - k * k
        inset = r - (q > 0 ? Math.sqrt(q) : 0)
      }
      const availW = m.cardW - inset * 2
      const byWidth = availW / (0.60 * d) * 0.96
      const nf = Math.min(byWidth, byHeight, 430)
      f = nf < f ? nf : f
    }
    return Math.round(f < 24 ? 24 : f)
  },

  syncFont() {
    this.fsTop = this.sizeFor(this.num(this.top))
    this.fsBot = this.sizeFor(this.num(this.bottom))
  },

  add(side) {
    const cur = this.num(this[side])
    if (cur >= 999) return
    this.touched = true
    this[side] = String(cur + 1)
    this.syncFont()
    this.buzz('short')
    this.save()
  },

  minus(side) {
    const cur = this.num(this[side])
    this.touched = true
    if (cur <= 0) {
      this.buzz('short')
      return
    }
    this[side] = String(cur - 1)
    this.syncFont()
    this.buzzDouble()
    this.save()
  },

  // 单击：立即 +1（不再等 300ms 判双击）
  tap(side) {
    // 长按已经减过分：这次触摸派发的 click 直接丢掉，避免"先减一后加一"
    if (this.longMark) {
      this.longMark = false
      return
    }
    this.add(side)
  },

  onTop(evt) {
    this.tap('top')
  },

  onBottom(evt) {
    this.tap('bottom')
  },

  // 长按 = 减分。系统在 longpress 之后还会补发一次 click，
  // 所以打上 longMark，让 tap() 把它丢掉，避免「先 −1 再 +1」
  onTopLong(evt) {
    this.longMark = true
    this.minus('top')
  },

  onBottomLong(evt) {
    this.longMark = true
    this.minus('bottom')
  },

  // ---------- 上滑两次：存记录 + 归零 ----------
  resetFlow() {
    const that = this
    if (!this.armed) {
      this.armed = true
      this.showMid('再滑确认', 2500)
      this.buzz('short')
      this.armTimer = setTimeout(function () {
        that.armed = false
        // 只在还停在确认提示上时才清空，避免把后出现的提示（诊断串）提前抹掉
        if (that.mid === '再滑确认') that.mid = ''
        that.armTimer = 0
      }, 2500)
      return
    }
    if (this.armTimer) clearTimeout(this.armTimer)
    this.armTimer = 0
    this.armed = false
    const t = this.num(this.top)
    const b = this.num(this.bottom)
    this.touched = true
    this.top = '0'
    this.bottom = '0'
    this.syncFont()
    this.buzzDouble()
    this.saveNow()
    // 0:0 不入列表；有比分才存档，并存完再用回调里的真实条数提示
    // （之前另起一次 loadRecords(force) 会和 addRecord 的内部回读抢时序，条数可能显示成旧的）
    if (t > 0 || b > 0) {
      addRecord(t, b, function (list) {
        const n = list ? list.length : 0
        // 把刚存下的比分一起回显，比只报条数更能确认「存的是这一局」
        that.showMid(t + ':' + b + ' 已存 ' + n + '条', 1800)
      })
    } else {
      this.mid = ''
    }
  },

  // ---------- 手势 ----------
  onTouchStart(evt) {
    this.startPoint = coord(evt)
    // 新的一次触摸：清掉上一次的长按标记
    this.longMark = false
  },

  onTouchEnd(evt) {
    const start = this.startPoint
    this.startPoint = null
    const end = coord(evt)
    if (!start || !end) return
    const dx = end.x - start.x
    const dy = end.y - start.y
    // 横向：左 -> 右 退出；右 -> 左 进记分列表
    if (Math.abs(dx) > Math.abs(dy)) {
      if (dx > 90) {
        this.saveNow()
        try {
          router.back()
        } catch (e) {}
      } else if (dx < -90) {
        this.saveNow()
        try {
          router.push({ uri: '/pages/history' })
        } catch (e) {}
      }
      return
    }
    // 上滑：重置（两次确认）。
    // 1.8.1 起改成「全行程」手势：必须从屏幕下方起手、真的划到上方才算，
    // 否则拇指在屏幕上蹭一下（原来只要 90 设计像素 ≈ 36 物理像素）就会进确认。
    // 阈值按屏高比例给，换机型自动适配（手环9：dh=1225 → 起点 ≥760 / 终点 ≤466 / 位移 ≥294）。
    const dh = this.metrics ? this.metrics.dh : 1225
    const dw = DESIGN_W
    this.lastG = Math.round(start.y) + '/' + Math.round(end.y) + '/' + Math.round(dy)
    // 阈值取整：1225*0.24 = 294.00000000000006，正好划到 294 会被浮点判成不达标
    const fullSweep =
      start.y >= Math.round(dh * 0.62) &&        // 起手必须在屏幕下方 38% 以内
      end.y <= Math.round(dh * 0.38) &&          // 手指必须真的划到上方 38% 以内
      dy <= -Math.round(dh * 0.24) &&            // 竖直行程至少 24% 屏高
      Math.abs(dx) <= Math.round(dw * 0.30) &&   // 横向漂移不超过 30% 屏宽
      Math.abs(dy) > Math.abs(dx) * 1.5          // 竖向为主
    if (fullSweep) {
      this.resetFlow()
      return
    }
  }
}
</script>

<style>
.root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #070e12;
}

.card {
  height: 48%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
  /* 首帧兜底：数据绑定要等第一次渲染后才生效，这里先给最终值，避免"先直角后圆角"的闪一下。
     240px = 屏宽 480 的一半：手环9 的屏幕是胶囊形（物理 192 宽、圆角半径 96），
     卡片贴边 + 同半径 ⇒ 卡片两端弧线与屏幕边缘同心、完全重合 */
  border-radius: 240px;
}

