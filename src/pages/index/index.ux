<template>
  <div class="root" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="card cardTop" onclick="onTop" onlongpress="onTopLong">
      <text class="score scoreTop" style="font-size: {{fsTop}}px">{{top}}</text>
    </div>
    <div class="mid">
      <text class="midText">{{mid}}</text>
    </div>
    <div class="card cardBot" onclick="onBottom" onlongpress="onBottomLong">
      <text class="score scoreBot" style="font-size: {{fsBot}}px">{{bottom}}</text>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import router from '@system.router'
import { loadScore, saveScore, addRecord, consumeScoreRefresh } from '../../common/store.js'

let bootScore = null

function coord(evt) {
  let t = evt
  if (evt && evt.touches && evt.touches.length) t = evt.touches[0]
  else if (evt && evt.changedTouches && evt.changedTouches.length) t = evt.changedTouches[0]
  if (!t) return null
  let x = t.clientX
  if (x === undefined || x === null) x = t.pageX
  if (x === undefined || x === null) x = t.offsetX
  let y = t.clientY
  if (y === undefined || y === null) y = t.pageY
  if (y === undefined || y === null) y = t.offsetY
  if (x === undefined || x === null || y === undefined || y === null) return null
  return { x: x, y: y }
}

export default {
  private: {
    top: '0',
    bottom: '0',
    fsTop: 400,
    fsBot: 400,
    mid: '',
    armed: false
  },

  onInit() {
    this.pendingTimer = 0
    this.armTimer = 0
    this.startPoint = null
    this.restored = false
    this.touched = false
    if (bootScore) {
      this.restored = true
      this.applyScore(bootScore.t, bootScore.b, false)
    }
  },

  onReady() {
    this.restore()
  },

  // 从列表页恢复或从后台回来时重新读一次
  onShow() {
    if (!this.restored || consumeScoreRefresh()) {
      this.restored = false
      this.restore()
    }
  },

  onHide() {
    this.saveNow()
  },

  onDestroy() {
    this.saveNow()
    if (this.pendingTimer) clearTimeout(this.pendingTimer)
    if (this.armTimer) clearTimeout(this.armTimer)
  },

  // ---------- 读取 / 应用 ----------
  restore() {
    const that = this
    loadScore(function (sc) {
      that.restored = true
      if (sc) {
        that.applyScore(sc.t, sc.b, true)
      } else {
        that.syncFont()
      }
    })
  },

  applyScore(t, b, defer) {
    const that = this
    const tt = t < 0 ? 0 : t
    const bb = b < 0 ? 0 : b
    bootScore = { t: tt, b: bb }
    const apply = function () {
      that.top = String(tt)
      that.bottom = String(bb)
      that.syncFont()
    }
    apply()
    if (defer) {
      // 防止框架用初始值重绘把异步恢复的结果盖掉
      setTimeout(function () {
        if (!that.touched) apply()
      }, 150)
    }
  },

  // ---------- 写入 ----------
  save() {
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    saveScore(bootScore.t, bootScore.b)
  },

  saveNow() {
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    saveScore(bootScore.t, bootScore.b)
  },

  // ---------- 基础 ----------
  buzz(mode) {
    try {
      vibrator.vibrate({ mode: mode || 'short' })
    } catch (e) {}
  },

  buzzDouble() {
    const that = this
    this.buzz('short')
    setTimeout(function () {
      that.buzz('short')
    }, 130)
  },

  num(v) {
    const n = parseInt(v, 10)
    return isNaN(n) ? 0 : n
  },

  // 数字越大字越大；3 位数收小，避免溢出卡片
  sizeFor(n) {
    if (n >= 100) return 210
    if (n >= 10) return 350
    return 400
  },

  syncFont() {
    this.fsTop = this.sizeFor(this.num(this.top))
    this.fsBot = this.sizeFor(this.num(this.bottom))
  },

  add(side) {
    const cur = this.num(this[side])
    if (cur >= 999) return
    this.touched = true
    this[side] = String(cur + 1)
    this.syncFont()
    this.buzz('short')
    this.save()
  },

  minus(side) {
    const cur = this.num(this[side])
    this.touched = true
    if (cur <= 0) {
      this.buzz('short')
      return
    }
    this[side] = String(cur - 1)
    this.syncFont()
    this.buzzDouble()
    this.save()
  },

  tap(side) {
    const that = this
    if (this.pendingTimer && this.pendingSide === side) {
      clearTimeout(this.pendingTimer)
      this.pendingTimer = 0
      this.pendingSide = ''
      this.minus(side)
      return
    }
    if (this.pendingTimer) {
      clearTimeout(this.pendingTimer)
      this.pendingTimer = 0
      const prev = this.pendingSide
      this.pendingSide = ''
      if (prev) this.add(prev)
    }
    this.pendingSide = side
    this.pendingTimer = setTimeout(function () {
      that.pendingTimer = 0
      const s = that.pendingSide
      that.pendingSide = ''
      if (s) that.add(s)
    }, 300)
  },

  onTop(evt) {
    this.tap('top')
  },

  onBottom(evt) {
    this.tap('bottom')
  },

  onTopLong(evt) {
    this.minus('top')
  },

  onBottomLong(evt) {
    this.minus('bottom')
  },

  // ---------- 上滑两次：存记录 + 归零 ----------
  resetFlow() {
    const that = this
    if (!this.armed) {
      this.armed = true
      this.mid = '再滑确认'
      this.buzz('short')
      this.armTimer = setTimeout(function () {
        that.armed = false
        that.mid = ''
        that.armTimer = 0
      }, 2500)
      return
    }
    if (this.armTimer) clearTimeout(this.armTimer)
    this.armTimer = 0
    this.armed = false
    const t = this.num(this.top)
    const b = this.num(this.bottom)
    // 0:0 不入列表
    if (t > 0 || b > 0) {
      addRecord(t, b)
    }
    this.touched = true
    this.top = '0'
    this.bottom = '0'
    this.syncFont()
    this.buzzDouble()
    this.save()
    this.mid = ''
  },

  // ---------- 手势 ----------
  onTouchStart(evt) {
    this.startPoint = coord(evt)
  },

  onTouchEnd(evt) {
    const start = this.startPoint
    this.startPoint = null
    const end = coord(evt)
    if (!start || !end) return
    const dx = end.x - start.x
    const dy = end.y - start.y
    // 横向：左 -> 右，退出
    if (Math.abs(dx) > Math.abs(dy)) {
      if (dx > 90) {
        this.saveNow()
        try {
          router.back()
        } catch (e) {}
      }
      return
    }
    // 上滑：重置（两次确认）
    if (dy < -90) {
      this.resetFlow()
      return
    }
    // 下滑：进入记分列表
    if (dy > 90) {
      this.saveNow()
      try {
        router.push({ uri: '/pages/history' })
      } catch (e) {}
    }
  }
}
</script>

<style>
.root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding: 14px;
  background-color: #070e12;
}

.card {
  height: 48%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
  border-radius: 52px;
}

.cardTop {
  background-color: #7fd9b7;
  border-color: #9ff0d5;
}

.cardBot {
  background-color: #92cdf5;
  border-color: #bfe6ff;
}

.mid {
  height: 4%;
  align-items: center;
  justify-content: center;
}

.midText {
  font-size: 24px;
  color: #5fc9a6;
}

.score {
  font-weight: bold;
  text-align: center;
}

.scoreTop {
  color: #06402c;
}

.scoreBot {
  color: #063a55;
}
</style>
