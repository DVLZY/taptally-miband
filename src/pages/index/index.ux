  background-color: #7fd9b7;
  border-color: #9ff0d5;
  border-radius: 240px;
}

.cardBot {
  background-color: #92cdf5;
  border-color: #bfe6ff;
  border-radius: 240px;
}

/* 必须写在 .cardTop/.cardBot 之后：同为单类选择器，后写的才生效 */
.rndPill {
  border-radius: 240px;
}

.rndRect {
  border-radius: 240px;
}

.rndCircle {
  border-radius: 240px;
}

.mid {
  height: 13%;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  /* 时钟字盒（font-size 189）比中缝（159）高，墨迹靠 align-items 居中；
     必须允许溢出，否则上下会被裁掉一截 */
  overflow: visible;
}

.clock {
  width: 100%;
  height: 100%;
  flex-direction: row;
