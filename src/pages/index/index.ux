<template>
  <div class="root" style="padding: {{pad}}px" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="card cardTop" style="border-radius: {{radius}}px" onclick="onTop" onlongpress="onTopLong">
      <text class="score scoreTop" style="font-size: {{fsTop}}px">{{top}}</text>
    </div>
    <div class="mid" onlongpress="onMidLong">
      <text class="midText" style="font-size: {{midFs}}px">{{mid}}</text>
    </div>
    <div class="card cardBot" style="border-radius: {{radius}}px" onclick="onBottom" onlongpress="onBottomLong">
      <text class="score scoreBot" style="font-size: {{fsBot}}px">{{bottom}}</text>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import router from '@system.router'
import device from '@system.device'
import { loadScore, saveScore, addRecord, consumeScoreRefresh } from '../../common/store.js'

const DESIGN_W = 480
let bootScore = null

function coord(evt) {
  let t = evt
  if (evt && evt.touches && evt.touches.length) t = evt.touches[0]
  else if (evt && evt.changedTouches && evt.changedTouches.length) t = evt.changedTouches[0]
  if (!t) return null
  let x = t.clientX
  if (x === undefined || x === null) x = t.pageX
  if (x === undefined || x === null) x = t.offsetX
  let y = t.clientY
  if (y === undefined || y === null) y = t.pageY
  if (y === undefined || y === null) y = t.offsetY
  if (x === undefined || x === null || y === undefined || y === null) return null
  return { x: x, y: y }
}

// 由屏幕宽高推出「设计高度」，再据此算卡片与字号：
// 任何比例的屏幕（手环 192x490、9 Pro 336x480、圆表 466x466…）都能自适应
function metricsOf(w, h, shape) {
  const dw = DESIGN_W
  const dh = dw * h / w
  let pad = 14
  if (shape === 'circle') pad = Math.round(dw * 0.1465)
  else if (shape === 'pill-shaped') pad = 18
  const gap = Math.round(dh * 0.04)
  const cardH = (dh - pad * 2 - gap) / 2
  const cardW = dw - pad * 2
  const radius = shape === 'rect' ? 52 : Math.round(cardH / 2)
  return { dh: dh, pad: pad, cardH: cardH, cardW: cardW, radius: radius }
}

export default {
  private: {
    top: '0',
    bottom: '0',
    fsTop: 362,
    fsBot: 425,
    pad: 14,
    radius: 52,
    midFs: 24,
    mid: '',
    armed: false
  },

  onInit() {
    this.pendingTimer = 0
    this.armTimer = 0
    this.startPoint = null
    this.restored = false
    this.touched = false
    // 手环 9 的默认值，拿到真实设备信息后再覆盖
    this.metrics = metricsOf(192, 490, 'rect')
    this.midFs = Math.max(18, Math.round(this.metrics.dh * 0.0196))
    if (bootScore) {
      this.restored = true
      this.applyScore(bootScore.t, bootScore.b, false)
    }
  },

  onReady() {
    this.syncDevice()
    this.restore()
  },

  onShow() {
    if (!this.restored || consumeScoreRefresh()) {
      this.restored = false
      this.restore()
    }
  },

  onHide() {
    this.saveNow()
  },

  onDestroy() {
    this.saveNow()
    if (this.pendingTimer) clearTimeout(this.pendingTimer)
    if (this.armTimer) clearTimeout(this.armTimer)
  },

  // 中间横条长按：显示屏幕参数，便于在未适配机型上确认分辨率/形状
  onMidLong() {
    const that = this
    const m = this.metrics || {}
    this.mid = (this.devW || '?') + 'x' + (this.devH || '?') + ' ' + (this.devShape || '?')
    this.buzz('short')
    if (this.armTimer) clearTimeout(this.armTimer)
    this.armTimer = setTimeout(function () {
      that.mid = ''
      that.armTimer = 0
    }, 3000)
  },

  // ---------- 屏幕自适应 ----------
  syncDevice() {
    const that = this
    try {
      device.getInfo({
        success: function (ret) {
          if (!ret || !ret.screenWidth || !ret.screenHeight) return
          that.applyMetrics(ret.screenWidth, ret.screenHeight, ret.screenShape)
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  applyMetrics(w, h, shape) {
    this.devW = w
    this.devH = h
    this.devShape = shape || 'rect'
    this.metrics = metricsOf(w, h, shape)
    this.pad = this.metrics.pad
    this.radius = this.metrics.radius
    this.midFs = Math.max(18, Math.round(this.metrics.dh * 0.0196))
    this.syncFont()
  },

  // ---------- 读取 / 应用 ----------
  restore() {
    const that = this
    loadScore(function (sc) {
      that.restored = true
      if (sc) {
        that.applyScore(sc.t, sc.b, true)
      } else {
        that.syncFont()
      }
    })
  },

  applyScore(t, b, defer) {
    const that = this
    const tt = t < 0 ? 0 : t
    const bb = b < 0 ? 0 : b
    bootScore = { t: tt, b: bb }
    const apply = function () {
      that.top = String(tt)
      that.bottom = String(bb)
      that.syncFont()
    }
    apply()
    if (defer) {
      setTimeout(function () {
        if (!that.touched) apply()
      }, 150)
    }
  },

  // ---------- 写入 ----------
  save() {
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    saveScore(bootScore.t, bootScore.b)
  },

  saveNow() {
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    saveScore(bootScore.t, bootScore.b)
  },

  // ---------- 基础 ----------
  buzz(mode) {
    try {
      vibrator.vibrate({ mode: mode || 'short' })
    } catch (e) {}
  },

  buzzDouble() {
    const that = this
    this.buzz('short')
    setTimeout(function () {
      that.buzz('short')
    }, 130)
  },

  num(v) {
    const n = parseInt(v, 10)
    return isNaN(n) ? 0 : n
  },

  // 字号同时受卡片宽、卡片高约束：位数越多越小，屏幕越矮越小
  sizeFor(n) {
    const d = String(n).length
    const m = this.metrics || metricsOf(192, 490, 'rect')
    const byWidth = m.cardW / (0.60 * d) * 0.96
    const byHeight = m.cardH * 0.74
    const f = Math.min(byWidth, byHeight, 430)
    return Math.round(f < 24 ? 24 : f)
  },

  syncFont() {
    this.fsTop = this.sizeFor(this.num(this.top))
    this.fsBot = this.sizeFor(this.num(this.bottom))
  },

  add(side) {
    const cur = this.num(this[side])
    if (cur >= 999) return
    this.touched = true
    this[side] = String(cur + 1)
    this.syncFont()
    this.buzz('short')
    this.save()
  },

  minus(side) {
    const cur = this.num(this[side])
    this.touched = true
    if (cur <= 0) {
      this.buzz('short')
      return
    }
    this[side] = String(cur - 1)
    this.syncFont()
    this.buzzDouble()
    this.save()
  },

  tap(side) {
    const that = this
    if (this.pendingTimer && this.pendingSide === side) {
      clearTimeout(this.pendingTimer)
      this.pendingTimer = 0
      this.pendingSide = ''
      this.minus(side)
      return
    }
    if (this.pendingTimer) {
      clearTimeout(this.pendingTimer)
      this.pendingTimer = 0
      const prev = this.pendingSide
      this.pendingSide = ''
      if (prev) this.add(prev)
    }
    this.pendingSide = side
    this.pendingTimer = setTimeout(function () {
      that.pendingTimer = 0
      const s = that.pendingSide
      that.pendingSide = ''
      if (s) that.add(s)
    }, 300)
  },

  onTop(evt) {
    this.tap('top')
  },

  onBottom(evt) {
    this.tap('bottom')
  },

  onTopLong(evt) {
    this.minus('top')
  },

  onBottomLong(evt) {
    this.minus('bottom')
  },

  // ---------- 上滑两次：存记录 + 归零 ----------
  resetFlow() {
    const that = this
    if (!this.armed) {
      this.armed = true
      this.mid = '再滑确认'
      this.buzz('short')
      this.armTimer = setTimeout(function () {
        that.armed = false
        that.mid = ''
        that.armTimer = 0
      }, 2500)
      return
    }
    if (this.armTimer) clearTimeout(this.armTimer)
    this.armTimer = 0
    this.armed = false
    const t = this.num(this.top)
    const b = this.num(this.bottom)
    // 0:0 不入列表
    if (t > 0 || b > 0) {
      addRecord(t, b)
    }
    this.touched = true
    this.top = '0'
    this.bottom = '0'
    this.syncFont()
    this.buzzDouble()
    this.save()
    this.mid = ''
  },

  // ---------- 手势 ----------
  onTouchStart(evt) {
    this.startPoint = coord(evt)
  },

  onTouchEnd(evt) {
    const start = this.startPoint
    this.startPoint = null
    const end = coord(evt)
    if (!start || !end) return
    const dx = end.x - start.x
    const dy = end.y - start.y
    // 横向：左 -> 右，退出
    if (Math.abs(dx) > Math.abs(dy)) {
      if (dx > 90) {
        this.saveNow()
        try {
          router.back()
        } catch (e) {}
      }
      return
    }
    // 上滑：重置（两次确认）
    if (dy < -90) {
      this.resetFlow()
      return
    }
    // 下滑：进入记分列表
    if (dy > 90) {
      this.saveNow()
      try {
        router.push({ uri: '/pages/history' })
      } catch (e) {}
    }
  }
}
</script>

<style>
.root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #070e12;
}

.card {
  height: 48%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
}

.cardTop {
  background-color: #7fd9b7;
  border-color: #9ff0d5;
}

.cardBot {
  background-color: #92cdf5;
  border-color: #bfe6ff;
}

.mid {
  height: 4%;
  align-items: center;
  justify-content: center;
}

.midText {
  color: #5fc9a6;
}

.score {
  font-weight: bold;
  text-align: center;
}

.scoreTop {
  color: #06402c;
}

.scoreBot {
  color: #063a55;
}
</style>
