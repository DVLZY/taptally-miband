<template>
  <div class="root" style="padding: {{pad}}px" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <div class="card cardTop {{rCls}}" style="height: {{cardH}}px" onclick="onTop" onlongpress="onTopLong">
      <text class="score scoreTop" style="font-size: {{fsTop}}px">{{top}}</text>
    </div>
    <div class="mid" style="height: {{gapH}}px" onlongpress="onMidLong">
      <text class="midText" style="font-size: {{midFs}}px">{{mid}}</text>
    </div>
    <div class="card cardBot {{rCls}}" style="height: {{cardH2}}px" onclick="onBottom" onlongpress="onBottomLong">
      <text class="score scoreBot" style="font-size: {{fsBot}}px">{{bottom}}</text>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import router from '@system.router'
import device from '@system.device'
import { loadScore, saveScore, addRecord, loadRecords, APP_VERSION } from '../../common/store.js'

const DESIGN_W = 480
let bootScore = null

function coord(evt) {
  let t = evt
  if (evt && evt.touches && evt.touches.length) t = evt.touches[0]
  else if (evt && evt.changedTouches && evt.changedTouches.length) t = evt.changedTouches[0]
  if (!t) return null
  let x = t.clientX
  if (x === undefined || x === null) x = t.pageX
  if (x === undefined || x === null) x = t.offsetX
  let y = t.clientY
  if (y === undefined || y === null) y = t.pageY
  if (y === undefined || y === null) y = t.offsetY
  if (x === undefined || x === null || y === undefined || y === null) return null
  return { x: x, y: y }
}

// 由屏幕宽高推出「设计高度」，再据此算卡片与字号：
// 任何比例的屏幕（手环 192x490、9 Pro 336x480、圆表 466x466…）都能自适应
function metricsOf(w, h, shape) {
  const dw = DESIGN_W
  const dh = dw * h / w
  // 圆屏必须留边（方角位置是屏幕外），胶囊屏（手环9/10）贴边显示，
  // 否则上下会露出一圈黑边
  let pad = 0
  if (shape === 'circle') pad = Math.round(dw * 0.1465)
  else if (shape !== 'pill-shaped') pad = 14
  const gap = Math.round(dh * 0.04)
  // 用整数像素分配高度，剩下的零头给下半区，保证两块+窄缝正好等于可用高度
  const usable = dh - pad * 2
  const cardH = Math.floor((usable - gap) / 2)
  const cardH2 = usable - gap - cardH
  const cardW = dw - pad * 2
  return { dh: dh, pad: pad, gap: gap, cardH: cardH, cardH2: cardH2, cardW: cardW }
}

export default {
  private: {
    top: '0',
    bottom: '0',
    rCls: '',
    fsTop: 425,
    fsBot: 425,
    pad: 0,
    gapH: 48,
    cardH: 574,
    cardH2: 574,
    midFs: 24,
    mid: '',
    armed: false
  },

  onInit() {
    this.armTimer = 0
    this.startPoint = null
    this.restored = false
    this.touched = false
    // 手环 9 的默认值，拿到真实设备信息后再覆盖
    this.metrics = metricsOf(192, 490, 'rect')
    this.midFs = Math.max(18, Math.round(this.metrics.dh * 0.0196))
    if (bootScore) {
      this.restored = true
      this.applyScore(bootScore.t, bootScore.b, false)
    }
  },

  onReady() {
    this.syncDevice()
    this.restore(false)
    // 预热历史记录缓存：加记录时才能合并出完整历史，而不是覆盖成 1 条
    loadRecords(function () {})
  },

  // 从列表页返回时**一定**强制回读一次磁盘：列表页可能刚把另一局的比分写进去
  onShow() {
    const that = this
    if (this.wasHidden) {
      this.wasHidden = false
      this.touched = false
      setTimeout(function () {
        that.restore(true)
      }, 60)
      return
    }
    if (!this.restored) this.restore(false)
  },

  onHide() {
    this.wasHidden = true
    this.saveNow()
  },

  onDestroy() {
    this.saveNow()
    if (this.armTimer) clearTimeout(this.armTimer)
  },

  // 中间横条长按：显示「屏幕参数 + 版本号 + 已存记录条数」
  // 换机型、确认装上的是哪一版、排查记录条数，都靠这一行
  onMidLong() {
    const that = this
    this.buzz('short')
    loadRecords(function (list) {
      that.showMid(
        (that.devW || '?') + 'x' + (that.devH || '?') + ' ' + (that.devShape || '?') +
        ' v' + APP_VERSION + ' r' + (list ? list.length : 0),
        4000
      )
    }, true)
  },

  showMid(text, ms) {
    const that = this
    this.mid = text
    if (this.armTimer) clearTimeout(this.armTimer)
    this.armTimer = setTimeout(function () {
      that.mid = ''
      that.armTimer = 0
    }, ms || 3000)
  },

  // ---------- 屏幕自适应 ----------
  syncDevice() {
    const that = this
    try {
      device.getInfo({
        success: function (ret) {
          if (!ret || !ret.screenWidth || !ret.screenHeight) return
          that.applyMetrics(ret.screenWidth, ret.screenHeight, ret.screenShape)
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  applyMetrics(w, h, shape) {
    // 圆角跟屏幕自身的圆角对齐：pill-shaped 屏（手环9）四角很圆，
    // 52px 显得方、1000px（胶囊）又太圆，取屏幕圆角量级 ≈ 屏宽×0.23
    this.rCls = shape === 'pill-shaped' ? 'rndPill' : (shape === 'circle' ? 'rndCircle' : 'rndRect')
    this.devW = w
    this.devH = h
    this.devShape = shape || 'rect'
    this.metrics = metricsOf(w, h, shape)
    this.pad = this.metrics.pad
    this.gapH = this.metrics.gap
    this.cardH = this.metrics.cardH
    this.cardH2 = this.metrics.cardH2
    this.midFs = Math.max(18, Math.round(this.metrics.dh * 0.0196))
    this.syncFont()
  },

  // ---------- 读取 / 应用 ----------
  // force=true 用于「从列表页恢复比分」：磁盘写入是异步的，一次读不到就重试几次，
  // 否则会出现「跳回来了但比分没变」。
  restore(force) {
    const that = this
    const attempt = function (left) {
      loadScore(function (sc) {
        that.restored = true
        if (sc) {
          that.applyScore(sc.t, sc.b, true)
          return
        }
        if (left > 1) {
          setTimeout(function () {
            attempt(left - 1)
          }, 150)
          return
        }
        that.syncFont()
      }, true)
    }
    attempt(force ? 4 : 1)
  },

  applyScore(t, b, defer) {
    const that = this
    const tt = t < 0 ? 0 : t
    const bb = b < 0 ? 0 : b
    bootScore = { t: tt, b: bb }
    const apply = function () {
      that.top = String(tt)
      that.bottom = String(bb)
      that.syncFont()
    }
    apply()
    if (defer) {
      setTimeout(function () {
        if (!that.touched) apply()
      }, 150)
    }
  },

  // ---------- 写入 ----------
  save() {
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    saveScore(bootScore.t, bootScore.b)
  },

  saveNow() {
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    saveScore(bootScore.t, bootScore.b)
  },

  // ---------- 基础 ----------
  buzz(mode) {
    try {
      vibrator.vibrate({ mode: mode || 'short' })
    } catch (e) {}
  },

  buzzDouble() {
    const that = this
    this.buzz('short')
    setTimeout(function () {
      that.buzz('short')
    }, 130)
  },

  num(v) {
    const n = parseInt(v, 10)
    return isNaN(n) ? 0 : n
  },

  // 字号同时受卡片宽、卡片高约束：位数越多越小，屏幕越矮越小
  sizeFor(n) {
    const d = String(n).length
    const m = this.metrics || metricsOf(192, 490, 'rect')
    const byWidth = m.cardW / (0.60 * d) * 0.96
    const byHeight = m.cardH * 0.74
    const f = Math.min(byWidth, byHeight, 430)
    return Math.round(f < 24 ? 24 : f)
  },

  syncFont() {
    this.fsTop = this.sizeFor(this.num(this.top))
    this.fsBot = this.sizeFor(this.num(this.bottom))
  },

  add(side) {
    const cur = this.num(this[side])
    if (cur >= 999) return
    this.touched = true
    this[side] = String(cur + 1)
    this.syncFont()
    this.buzz('short')
    this.save()
  },

  minus(side) {
    const cur = this.num(this[side])
    this.touched = true
    if (cur <= 0) {
      this.buzz('short')
      return
    }
    this[side] = String(cur - 1)
    this.syncFont()
    this.buzzDouble()
    this.save()
  },

  // 单击：立即 +1（不再等 300ms 判双击）
  tap(side) {
    // 长按已经减过分：这次触摸派发的 click 直接丢掉，避免"先减一后加一"
    if (this.longMark) {
      this.longMark = false
      return
    }
    this.add(side)
  },

  onTop(evt) {
    this.tap('top')
  },

  onBottom(evt) {
    this.tap('bottom')
  },

  // 长按 = 减分。注意：长按之后系统还会再派发一次 click，
  // 打上 longMark：长按之后系统还会补发一次 click，tap() 见到标记直接丢掉
  onTopLong(evt) {
    this.longMark = true
    this.minus('top')
  },

  onBottomLong(evt) {
    this.longMark = true
    this.minus('bottom')
  },

  // ---------- 上滑两次：存记录 + 归零 ----------
  resetFlow() {
    const that = this
    if (!this.armed) {
      this.armed = true
      this.mid = '再滑确认'
      this.buzz('short')
      this.armTimer = setTimeout(function () {
        that.armed = false
        that.mid = ''
        that.armTimer = 0
      }, 2500)
      return
    }
    if (this.armTimer) clearTimeout(this.armTimer)
    this.armTimer = 0
    this.armed = false
    const t = this.num(this.top)
    const b = this.num(this.bottom)
    // 0:0 不入列表
    if (t > 0 || b > 0) {
      addRecord(t, b)
    }
    this.touched = true
    this.top = '0'
    this.bottom = '0'
    this.syncFont()
    this.buzzDouble()
    this.save()
    this.mid = ''
    const that2 = this
    loadRecords(function (list) {
      that2.showMid('已存 ' + (list ? list.length : 0) + ' 条', 1500)
    }, true)
  },

  // ---------- 手势 ----------
  onTouchStart(evt) {
    this.startPoint = coord(evt)
    // 新的一次触摸：清掉上一次的长按标记
    this.longMark = false
  },

  onTouchEnd(evt) {
    const start = this.startPoint
    this.startPoint = null
    const end = coord(evt)
    if (!start || !end) return
    const dx = end.x - start.x
    const dy = end.y - start.y
    // 横向：左 -> 右 退出；右 -> 左 进记分列表
    if (Math.abs(dx) > Math.abs(dy)) {
      if (dx > 90) {
        this.saveNow()
        try {
          router.back()
        } catch (e) {}
      } else if (dx < -90) {
        this.saveNow()
        try {
          router.push({ uri: '/pages/history' })
        } catch (e) {}
      }
      return
    }
    // 上滑：重置（两次确认）
    if (dy < -90) {
      this.resetFlow()
      return
    }
  }
}
</script>

<style>
.root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #070e12;
}

.card {
  height: 48%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
  /* 首帧兜底：数据绑定要等第一次渲染后才生效，
     这里先给手环9 的圆角（300px），避免"先直角后圆角"的闪一下 */
  border-radius: 300px;
}

.cardTop {
  background-color: #7fd9b7;
  border-color: #9ff0d5;
  border-radius: 300px;
}

.cardBot {
  background-color: #92cdf5;
  border-color: #bfe6ff;
  border-radius: 300px;
}

/* 必须写在 .cardTop/.cardBot 之后：同为单类选择器，后写的才生效 */
.rndPill {
  border-radius: 300px;
}

.rndRect {
  border-radius: 52px;
}

.rndCircle {
  border-radius: 260px;
}

.mid {
  height: 4%;
  align-items: center;
  justify-content: center;
}

.midText {
  color: #5fc9a6;
}

.score {
  font-weight: bold;
  text-align: center;
}

.scoreTop {
  color: #06402c;
}

.scoreBot {
  color: #063a55;
}
</style>
