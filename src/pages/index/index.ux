<template>
  <div class="root {{enterCls}}" ontouchstart="onTouchStart" ontouchend="onTouchEnd">
    <!-- 两页并排放在同一个容器里，靠 translateX 左右平移切换：
         比 router 切页更连续（系统转场不可配置，切页必然是硬切） -->
    <div class="pager {{pagerCls}}">
      <!-- 第 1 页：记分 -->
      <div class="page" style="padding: {{pad}}px">
        <div class="card cardTop {{rCls}} {{pressTop}}" style="height: {{cardH}}px" onclick="onTop" onlongpress="onTopLong">
          <text class="score scoreTop" style="font-size: {{fsTop}}px">{{top}}</text>
        </div>
        <div class="mid" style="height: {{gapH}}px" onlongpress="onMidLong">
          <text class="midText {{midCls}}" style="font-size: {{midFs}}px">{{mid}}</text>
        </div>
        <div class="card cardBot {{rCls}} {{pressBot}}" style="height: {{cardH2}}px" onclick="onBottom" onlongpress="onBottomLong">
          <text class="score scoreBot" style="font-size: {{fsBot}}px">{{bottom}}</text>
        </div>
      </div>
      <!-- 第 2 页：记分列表 -->
      <div class="page" style="padding-left: {{pad}}px; padding-right: {{pad}}px">
        <div class="head">
          <text class="title" style="font-size: {{titleFs}}px" onlongpress="onTitleLong">记录</text>
          <text class="dbg" style="font-size: {{dbgFs}}px">{{dbg}}</text>
        </div>
        <div class="items">
          <div class="item" for="{{records}}" tid="id" style="height: {{itemH}}px; margin-bottom: {{itemGap}}px" onclick="onPick($idx)" onlongpress="onDrop($idx)">
            <text class="no" style="font-size: {{noFs}}px; width: {{noW}}px">{{$item.no}}</text>
            <div class="{{$item.side}}" style="height: {{barH}}px; width: {{accentW}}px; margin-left: {{accentMl}}px; margin-right: {{accentMr}}px"></div>
            <text class="val" style="font-size: {{$item.fs}}px; width: {{valW}}px">{{$item.score}}</text>
          </div>
          <div class="empty" if="{{empty}}">
            <text class="emptyText" style="font-size: {{noFs}}px">还没有记录</text>
          </div>
        </div>
        <div class="foot">
          <text class="footText" style="font-size: {{footFs}}px" onlongpress="onFootLong">{{foot}}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import vibrator from '@system.vibrator'
import router from '@system.router'
import device from '@system.device'
import { loadScore, saveScore, addRecord, loadRecords, removeRecord, debugStats, MAX_RECORDS, APP_VERSION } from '../../common/store.js'

const DESIGN_W = 480
let bootScore = null

function coord(evt) {
  let t = evt
  if (evt && evt.touches && evt.touches.length) t = evt.touches[0]
  else if (evt && evt.changedTouches && evt.changedTouches.length) t = evt.changedTouches[0]
  if (!t) return null
  let x = t.clientX
  if (x === undefined || x === null) x = t.pageX
  if (x === undefined || x === null) x = t.offsetX
  let y = t.clientY
  if (y === undefined || y === null) y = t.pageY
  if (y === undefined || y === null) y = t.offsetY
  if (x === undefined || x === null || y === undefined || y === null) return null
  return { x: x, y: y }
}

// 由屏幕宽高推出「设计高度」，再据此算卡片与字号：
// 任何比例的屏幕（手环 192x490、9 Pro 336x480、圆表 466x466…）都能自适应
function metricsOf(w, h, shape) {
  const dw = DESIGN_W
  const dh = dw * h / w
  // 圆屏必须留边（方角位置是屏幕外），胶囊屏（手环9/10）贴边显示，
  // 否则上下会露出一圈黑边
  let pad = 0
  if (shape === 'circle') pad = Math.round(dw * 0.1465)
  else if (shape !== 'pill-shaped') pad = 14
  const gap = Math.round(dh * 0.04)
  // 用整数像素分配高度，剩下的零头给下半区，保证两块+窄缝正好等于可用高度
  const usable = dh - pad * 2
  const cardH = Math.floor((usable - gap) / 2)
  const cardH2 = usable - gap - cardH
  const cardW = dw - pad * 2
  return { dh: dh, pad: pad, gap: gap, cardH: cardH, cardH2: cardH2, cardW: cardW }
}

export default {
  private: {
    top: '0',
    // 动效状态：靠切换类名重放动画（Vela 里改回同名类不会重新触发）
    enterCls: '',
    exitCls: '',
    pressTop: '',
    pressBot: '',
    midCls: '',
    bottom: '0',
    rCls: '',
    fsTop: 425,
    fsBot: 425,
    pad: 0,
    gapH: 48,
    cardH: 574,
    cardH2: 574,
    midFs: 24,
    mid: '',
    armed: false,
    // 以下必须在 private 里声明，否则赋值不会触发视图更新（列表会整页空白）
    pagerCls: '',
    records: [],
    empty: true,
    dbgOn: false,
    dbg: '',
    itemH: 153,
    itemGap: 24,
    barH: 80,
    itemFs: 101,
    noFs: 80,
    titleFs: 44,
    dbgFs: 56,
    footFs: 44,
    accentW: 11,
    accentMl: 9,
    accentMr: 31,
    noW: 70,
    valW: 219
  },

  onInit() {
    this.armTimer = 0 // 上滑「再滑确认」的计时器
    this.midTimer = 0 // 中间提示文字的计时器（两者必须分开，见 showMid 注释）
    this.startPoint = null
    this.restored = false
    this.touched = false
    // 手环 9（192x490 胶囊屏）的默认值，拿到真实设备信息后再覆盖。
    // 这里必须把 metrics 同步到视图字段：否则首帧用的是 CSS 里的百分比兜底，
    // 等 device.getInfo 回来才跳一次（表现为「闪一下」）。
    this.metrics = metricsOf(192, 490, 'pill-shaped')
    this.pad = this.metrics.pad
    this.gapH = this.metrics.gap
    this.cardH = this.metrics.cardH
    this.cardH2 = this.metrics.cardH2
    this.rCls = 'rndPill'
    this.midFs = Math.max(18, Math.round(this.metrics.dh * 0.0196))
    if (bootScore) {
      this.restored = true
      this.applyScore(bootScore.t, bootScore.b, false)
    }
  },

  onReady() {
    this.playEnter()
    this.applyHistMetrics()
    this.syncDevice()
    this.restore(false)
    // 预热历史记录缓存：加记录时才能合并出完整历史，而不是覆盖成 1 条
    loadRecords(function () {})
  },

  // 从列表页返回时**一定**强制回读一次磁盘：列表页可能刚把另一局的比分写进去
  onShow() {
    const that = this
    this.playEnter()          // 从列表页回来也重新播一次，切换不突兀
    if (this.wasHidden) {
      this.wasHidden = false
      this.touched = false
      setTimeout(function () {
        that.restore(true)
      }, 60)
      return
    }
    if (!this.restored) this.restore(false)
  },

  onHide() {
    this.wasHidden = true
    this.saveNow()
  },

  onDestroy() {
    this.saveNow()
    if (this.armTimer) clearTimeout(this.armTimer)
    if (this.midTimer) clearTimeout(this.midTimer)
  },

  // 中间横条长按：显示「屏幕参数 + 版本号 + 已存记录条数」
  // 换机型、确认装上的是哪一版、排查记录条数，都靠这一行
  onMidLong() {
    const that = this
    this.buzz('short')
    loadRecords(function (list) {
      that.showMid(
        (that.devW || '?') + 'x' + (that.devH || '?') + ' ' + (that.devShape || '?') +
        ' v' + APP_VERSION + ' r' + (list ? list.length : 0),
        4000
      )
    }, true)
  },

  // 中间窄缝显示一行字（诊断串 / 「再滑确认」/「已存 N 条」）
  // 注意：这里只能清自己的 midTimer。1.7.0 及以前用的是 armTimer，
  // 结果长按中缝看诊断时会把「再滑确认」的计时器清掉、armed 却还是 true，
  // 下一次上滑就被当成第二次确认直接归零。
  showMid(text, ms) {
    const that = this
    this.mid = text
    this.midCls = this.midCls === 'fadeA' ? 'fadeB' : 'fadeA'
    if (this.midClsTimer) clearTimeout(this.midClsTimer)
    this.midClsTimer = setTimeout(function () {
      that.midCls = ''
      that.midClsTimer = 0
    }, 200)
    if (this.midTimer) clearTimeout(this.midTimer)
    this.midTimer = setTimeout(function () {
      that.mid = ''
      that.midTimer = 0
    }, ms || 3000)
  },

  // ---------- 动效 ----------
  // Vela 里把类名改回同名不会重放动画，所以每次都在 A/B 两个等价类之间切换
  playEnter() {
    const that = this
    // 页面刚 attach 时立刻挂类，第一帧可能还没画出来，动画相当于被吞掉；
    // 隔一帧再挂，进入动效才真的看得见
    if (this.enterReadyTimer) clearTimeout(this.enterReadyTimer)
    this.enterReadyTimer = setTimeout(function () {
      that.enterCls = that.enterCls === 'enterA' ? 'enterB' : 'enterA'
      that.enterReadyTimer = 0
    }, 40)
    if (this.enterTimer) clearTimeout(this.enterTimer)
    this.enterTimer = setTimeout(function () {
      that.enterCls = ''
      that.enterTimer = 0
    }, 420)
  },

  pressAt(y) {
    const edge = this.pad + this.cardH
    if (y <= edge) {
      this.pressTop = 'pressed'
      this.pressBot = ''
    } else {
      this.pressBot = 'pressed'
      this.pressTop = ''
    }
  },

  releasePress() {
    const that = this
    // 延迟一点再复位，手指点得快也能看到按下的那一帧
    if (this.pressTimer) clearTimeout(this.pressTimer)
    this.pressTimer = setTimeout(function () {
      that.pressTop = ''
      that.pressBot = ''
      that.pressTimer = 0
    }, 90)
  },

  // ---------- 第二页：记分列表 ----------
  histMetrics() {
    const m = this.metrics || metricsOf(192, 490, 'circle')
    const dh = m.dh
    const dw = DESIGN_W
    const pad = m.pad
    const itemH = Math.max(76, Math.min(186, Math.round(dh * 0.125)))
    const noW = Math.round(itemH * 0.46)
    const accentW = Math.max(6, Math.round(itemH * 0.075))
    const accentMl = Math.round(itemH * 0.06)
    const accentMr = Math.round(itemH * 0.20)
    let valW = dw - pad * 2 - noW - accentW - accentMl - accentMr - Math.round(itemH * 0.08)
    if (valW < 90) valW = 90
    return {
      itemH: itemH,
      itemGap: Math.round(itemH * 0.16),
      barH: Math.round(itemH * 0.52),
      itemFs: Math.round(itemH * 0.66),
      noFs: Math.max(24, Math.round(itemH * 0.52)),
      titleFs: Math.max(24, Math.round(dh * 0.036)),
      dbgFs: Math.round(dh * 0.046),
      footFs: Math.max(30, Math.round(dh * 0.036)),
      accentW: accentW,
      accentMl: accentMl,
      accentMr: accentMr,
      noW: noW,
      valW: valW
    }
  },

  applyHistMetrics() {
    const m = this.histMetrics()
    this.itemH = m.itemH
    this.itemGap = m.itemGap
    this.barH = m.barH
    this.itemFs = m.itemFs
    this.noFs = m.noFs
    this.titleFs = m.titleFs
    this.dbgFs = m.dbgFs
    this.footFs = m.footFs
    this.accentW = m.accentW
    this.accentMl = m.accentMl
    this.accentMr = m.accentMr
    this.noW = m.noW
    this.valW = m.valW
  },

  // 横向平移切页：pager 宽 200%，translateX(-50%) 正好挪一屏
  openHistory() {
    this.saveNow()
    this.applyHistMetrics()
    this.renderRecords()
    this.pagerCls = 'pagerOn'
    this.buzz('short')
  },

  closeHistory() {
    this.pagerCls = ''
  },

  renderRecords() {
    const that = this
    loadRecords(function (list) {
      const arr = (list || []).slice(0)
      arr.sort(function (a, b) {
        return (b.ts || 0) - (a.ts || 0)
      })
      that.raw = arr
      const rows = []
      for (let i = 0; i < arr.length && i < MAX_RECORDS; i++) {
        let side = 'accent accentD'
        if (arr[i].t > arr[i].b) side = 'accent accentA'
        else if (arr[i].b > arr[i].t) side = 'accent accentB'
        const txt = arr[i].t + ':' + arr[i].b
        // 比分越长字号越小：字宽≈0.62×字号（含冒号），保证不顶出条目
        let fs = that.itemFs
        const byW = Math.floor(that.valW / (0.62 * txt.length))
        if (byW < fs) fs = byW
        rows.push({
          id: 'r' + i + '_' + (arr[i].ts || 0),
          no: String(i + 1),
          score: txt,
          fs: fs,
          side: side
        })
      }
      that.records = rows
      that.empty = rows.length === 0
      if (that.dbgOn) {
        debugStats(function (st) {
          that.dbg = 'S' + st.s + ' F' + st.f + ' N' + st.c
        })
      }
    })
  },

  onPick(idx) {
    if (this.longMark) {
      this.longMark = false
      return
    }
    const it = this.raw[idx]
    if (!it) return
    this.buzz('short')
    saveScore(it.t, it.b)
    this.applyScore(it.t, it.b, true)
    this.pagerCls = ''
  },

  onDrop(idx) {
    this.longMark = true
    const that = this
    const it = this.raw[idx]
    if (!it) return
    this.buzz('short')
    removeRecord(it.ts, function () {
      that.renderRecords()
    })
  },

  onTitleLong() {
    const that = this
    this.buzz('short')
    this.dbgOn = !this.dbgOn
    if (!this.dbgOn) {
      this.dbg = ''
      return
    }
    debugStats(function (st) {
      that.dbg = 'S' + st.s + ' F' + st.f + ' N' + st.c
    })
  },

  onFootLong() {
    try {
      router.push({ uri: '/pages/probe' })
    } catch (e) {}
  },

  // 离场：先把内容滑走/淡出，再真正切页，避免"啪一下换屏"
  leaveTo(uri, back) {
    const that = this
    if (this.leaving) return
    this.leaving = true
    this.exitCls = this.exitCls === 'exitA' ? 'exitB' : 'exitA'
    setTimeout(function () {
      that.exitCls = ''
      that.leaving = false
      try {
        if (back) router.back()
        else router.push({ uri: uri })
      } catch (e) {}
    }, 150)
  },

  // ---------- 屏幕自适应 ----------
  syncDevice() {
    const that = this
    try {
      device.getInfo({
        success: function (ret) {
          if (!ret || !ret.screenWidth || !ret.screenHeight) return
          that.applyMetrics(ret.screenWidth, ret.screenHeight, ret.screenShape)
        },
        fail: function () {}
      })
    } catch (e) {}
  },

  applyMetrics(w, h, shape) {
    // 圆角跟屏幕自身的圆角对齐：pill-shaped 屏（手环9）四角很圆，
    // 52px 显得方、1000px（胶囊）又太圆，取屏幕圆角量级 ≈ 屏宽×0.23
    this.rCls = shape === 'pill-shaped' ? 'rndPill' : (shape === 'circle' ? 'rndCircle' : 'rndRect')
    this.devW = w
    this.devH = h
    this.devShape = shape || 'rect'
    this.metrics = metricsOf(w, h, shape)
    this.pad = this.metrics.pad
    this.gapH = this.metrics.gap
    this.cardH = this.metrics.cardH
    this.cardH2 = this.metrics.cardH2
    this.midFs = Math.max(18, Math.round(this.metrics.dh * 0.0196))
    this.syncFont()
  },

  // ---------- 读取 / 应用 ----------
  // force=true 用于「从列表页恢复比分」：磁盘写入是异步的，一次读不到就重试几次，
  // 否则会出现「跳回来了但比分没变」。
  restore(force) {
    const that = this
    // 非强制模式下，正在进行的首轮读取还没回来就别再发一次
    if (!force && this.restorePending) return
    this.restorePending = true
    // 兜底：万一某个通道的回调没回来，1.2 秒后也要把标记放开，
    // 否则后续 onShow 的恢复会被这个标记一直挡住
    setTimeout(function () {
      that.restorePending = false
    }, 1200)
    const attempt = function (left) {
      loadScore(function (sc) {
        that.restored = true
        if (sc) {
          that.restorePending = false
          that.applyScore(sc.t, sc.b, true)
          return
        }
        if (left > 1) {
          setTimeout(function () {
            attempt(left - 1)
          }, 150)
          return
        }
        that.restorePending = false
        that.syncFont()
      }, true)
    }
    attempt(force ? 4 : 1)
  },

  applyScore(t, b, defer) {
    const that = this
    const tt = t < 0 ? 0 : t
    const bb = b < 0 ? 0 : b
    bootScore = { t: tt, b: bb }
    const apply = function () {
      that.top = String(tt)
      that.bottom = String(bb)
      that.syncFont()
    }
    apply()
    if (defer) {
      setTimeout(function () {
        if (!that.touched) apply()
      }, 150)
    }
  },

  // ---------- 写入 ----------
  // 连点时会连续触发写盘，而手环的 flash 写入不宜过于频繁：
  // save() 只排一次 250ms 后的写；真正需要立即落盘的时机（退出、切页、归零、恢复）
  // 一律走 saveNow()。
  save() {
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    const that = this
    if (this.saveTimer) clearTimeout(this.saveTimer)
    this.saveTimer = setTimeout(function () {
      that.saveTimer = 0
      saveScore(bootScore.t, bootScore.b)
    }, 250)
  },

  saveNow() {
    if (this.saveTimer) {
      clearTimeout(this.saveTimer)
      this.saveTimer = 0
    }
    bootScore = { t: this.num(this.top), b: this.num(this.bottom) }
    saveScore(bootScore.t, bootScore.b)
  },

  // ---------- 基础 ----------
  buzz(mode) {
    try {
      vibrator.vibrate({ mode: mode || 'short' })
    } catch (e) {}
  },

  buzzDouble() {
    const that = this
    this.buzz('short')
    setTimeout(function () {
      that.buzz('short')
    }, 130)
  },

  num(v) {
    const n = parseInt(v, 10)
    return isNaN(n) ? 0 : n
  },

  // 字号同时受卡片宽、卡片高约束：位数越多越小，屏幕越矮越小
  sizeFor(n) {
    const d = String(n).length
    const m = this.metrics || metricsOf(192, 490, 'rect')
    const byWidth = m.cardW / (0.60 * d) * 0.96
    const byHeight = m.cardH * 0.74
    const f = Math.min(byWidth, byHeight, 430)
    return Math.round(f < 24 ? 24 : f)
  },

  syncFont() {
    this.fsTop = this.sizeFor(this.num(this.top))
    this.fsBot = this.sizeFor(this.num(this.bottom))
  },

  add(side) {
    const cur = this.num(this[side])
    if (cur >= 999) return
    this.touched = true
    this[side] = String(cur + 1)
    this.syncFont()
    this.buzz('short')
    this.save()
  },

  minus(side) {
    const cur = this.num(this[side])
    this.touched = true
    if (cur <= 0) {
      this.buzz('short')
      return
    }
    this[side] = String(cur - 1)
    this.syncFont()
    this.buzzDouble()
    this.save()
  },

  // 单击：立即 +1（不再等 300ms 判双击）
  tap(side) {
    // 长按已经减过分：这次触摸派发的 click 直接丢掉，避免"先减一后加一"
    if (this.longMark) {
      this.longMark = false
      return
    }
    this.add(side)
  },

  onTop(evt) {
    this.tap('top')
  },

  onBottom(evt) {
    this.tap('bottom')
  },

  // 长按 = 减分。系统在 longpress 之后还会补发一次 click，
  // 所以打上 longMark，让 tap() 把它丢掉，避免「先 −1 再 +1」
  onTopLong(evt) {
    this.longMark = true
    this.minus('top')
  },

  onBottomLong(evt) {
    this.longMark = true
    this.minus('bottom')
  },

  // ---------- 上滑两次：存记录 + 归零 ----------
  resetFlow() {
    const that = this
    if (!this.armed) {
      this.armed = true
      this.showMid('再滑确认', 2500)
      this.buzz('short')
      this.armTimer = setTimeout(function () {
        that.armed = false
        // 只在还停在确认提示上时才清空，避免把后出现的提示（诊断串）提前抹掉
        if (that.mid === '再滑确认') that.mid = ''
        that.armTimer = 0
      }, 2500)
      return
    }
    if (this.armTimer) clearTimeout(this.armTimer)
    this.armTimer = 0
    this.armed = false
    const t = this.num(this.top)
    const b = this.num(this.bottom)
    this.touched = true
    this.top = '0'
    this.bottom = '0'
    this.syncFont()
    this.buzzDouble()
    this.saveNow()
    // 0:0 不入列表；有比分才存档，并存完再用回调里的真实条数提示
    // （之前另起一次 loadRecords(force) 会和 addRecord 的内部回读抢时序，条数可能显示成旧的）
    if (t > 0 || b > 0) {
      addRecord(t, b, function (list) {
        const n = list ? list.length : 0
        // 把刚存下的比分一起回显，比只报条数更能确认「存的是这一局」
        that.showMid(t + ':' + b + ' 已存 ' + n + '条', 1800)
      })
    } else {
      this.mid = ''
    }
  },

  // ---------- 手势 ----------
  onTouchStart(evt) {
    this.startPoint = coord(evt)
    // 新的一次触摸：清掉上一次的长按标记
    this.longMark = false
    if (this.startPoint) this.pressAt(this.startPoint.y)
  },

  onTouchEnd(evt) {
    this.releasePress()
    const start = this.startPoint
    this.startPoint = null
    const end = coord(evt)
    if (!start || !end) return
    const dx = end.x - start.x
    const dy = end.y - start.y
    // 横滑：在列表页左->右返回记分页；在记分页 右->左 进列表、左->右 退出应用
    if (Math.abs(dx) > Math.abs(dy)) {
      if (this.pagerCls === 'pagerOn') {
        if (dx > 90) {
          this.buzz('short')
          this.closeHistory()
        }
        return
      }
      if (dx < -90) {
        this.openHistory()
      } else if (dx > 90) {
        this.saveNow()
        this.leaveTo(null, true)
      }
      return
    }
    if (this.pagerCls === 'pagerOn') return
    // 上滑：重置（两次确认）
    if (dy < -90) {
      this.resetFlow()
      return
    }
  }
}
</script>

<style>
.root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  background-color: #070e12;
}

.card {
  height: 48%;
  align-items: center;
  justify-content: center;
  border-width: 2px;
  /* 首帧兜底：数据绑定要等第一次渲染后才生效，这里先给最终值，避免"先直角后圆角"的闪一下。
     170px = 卡片半宽（圆屏分支下卡宽 340），圆角与屏幕两端的胶囊弧度一致 */
  border-radius: 170px;
}

.cardTop {
  background-color: #7fd9b7;
  border-color: #9ff0d5;
  border-radius: 170px;
}

.cardBot {
  background-color: #92cdf5;
  border-color: #bfe6ff;
  border-radius: 170px;
}

/* 必须写在 .cardTop/.cardBot 之后：同为单类选择器，后写的才生效 */
.rndPill {
  border-radius: 170px;
}

.rndRect {
  border-radius: 52px;
}

.rndCircle {
  border-radius: 170px;
}

.mid {
  height: 4%;
  align-items: center;
  justify-content: center;
}

.midText {
  color: #5fc9a6;
}

.score {
  font-weight: bold;
  text-align: center;
}

/* ---------- 动效 ----------
   Vela 支持 transform / transition / @keyframes；@keyframes 里能动画的属性只有
   background-color、background-position、opacity、width/height（不支持百分比）、transform。
   这里只用 opacity 与 transform，成本最低、不触发重新排版。 */
/* 按下反馈只用 opacity：动 transform 会让带圆角+边框的卡片在某些机型上
   重新栅格化，出现一条竖向接缝，所以这里不碰几何属性 */
.card {
  transition-property: all;
  transition-duration: 110ms;
  transition-timing-function: ease-out;
}

.pressed {
  opacity: 0.9;
}

.enterA {
  animation-name: enterA;
  animation-duration: 260ms;
  animation-timing-function: cubic-bezier(0.2, 0.9, 0.25, 1);
}

.enterB {
  animation-name: enterB;
  animation-duration: 260ms;
  animation-timing-function: cubic-bezier(0.2, 0.9, 0.25, 1);
}

@keyframes enterA {
  0% { opacity: 0; transform: translateX(40px); }
  100% { opacity: 1; transform: translateX(0px); }
}

@keyframes enterB {
  0% { opacity: 0; transform: translateX(40px); }
  100% { opacity: 1; transform: translateX(0px); }
}


.exitA {
  animation-name: exitA;
  animation-duration: 150ms;
  animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
}

.exitB {
  animation-name: exitB;
  animation-duration: 150ms;
  animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
}

@keyframes exitA {
  0% { opacity: 1; transform: translateX(0px); }
  100% { opacity: 0; transform: translateX(-46px); }
}

@keyframes exitB {
  0% { opacity: 1; transform: translateX(0px); }
  100% { opacity: 0; transform: translateX(-46px); }
}

.fadeA {
  animation-name: fadeA;
  animation-duration: 170ms;
  animation-timing-function: ease-out;
}

.fadeB {
  animation-name: fadeB;
  animation-duration: 170ms;
  animation-timing-function: ease-out;
}

@keyframes fadeA {
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes fadeB {
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.scoreTop {
  color: #06402c;
}

.scoreBot {
  color: #063a55;
}

.pager {
  width: 200%;
  height: 100%;
  flex-direction: row;
  transition-property: all;
  transition-duration: 260ms;
  transition-timing-function: cubic-bezier(0.2, 0.9, 0.25, 1);
}

.pagerOn {
  transform: translateX(-50%);
}

.page {
  width: 50%;
  height: 100%;
  flex-direction: column;
}

/* ---------- 记分列表页（原来在 pages/history） ---------- */
.head {
  height: 12%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.title {
  color: #e8f3f4;
  font-weight: bold;
}

.dbg {
  color: #6ee3b4;
  font-weight: bold;
}

.items {
  height: 78%;
  flex-direction: column;
}

.item {
  flex-direction: row;
  align-items: center;
  border-width: 2px;
  border-color: #1d2f39;
  border-radius: 30px;
  background-color: #16232b;
}

.no {
  color: #7d97a8;
  text-align: center;
}

.accent {
  border-radius: 6px;
}

.accentA {
  background-color: #56d9ae;
}

.accentB {
  background-color: #6cc5f3;
}

.accentD {
  background-color: #46606d;
}

.val {
  color: #eaf4f6;
  font-weight: bold;
  text-align: center;
}

.empty {
  align-items: center;
  justify-content: center;
}

.emptyText {
  color: #4e6672;
}

.foot {
  height: 10%;
  align-items: center;
  justify-content: center;
}

.footText {
  color: #3d5561;
}
</style>
